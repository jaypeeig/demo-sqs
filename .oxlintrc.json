{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist", "coverage", "node_modules"]
}
