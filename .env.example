# Copy to .env to override. None of these are required for local development -
# the defaults already point at the ElasticMQ container from docker-compose.yml.

# AWS region the SQS client is configured for.
AWS_REGION=ap-southeast-1

# Name of the queue to produce to / consume from. Created automatically
# (locally) if it doesn't exist yet.
SQS_QUEUE_NAME=DemoQueue

# Local SQS emulator endpoint. Leave unset to use this default. Set to an
# empty string to fall back to the AWS SDK's default credential chain and
# talk to real AWS instead:
#   SQS_ENDPOINT=
SQS_ENDPOINT=http://localhost:9324

# debug | info | warn | error
LOG_LEVEL=info
